# Angel One SmartAPI credentials for fetch_data.py
# Copy to .env (gitignored) and fill in. Never commit .env.
#
# ANGEL_API_KEY      : API key of a SmartAPI app (create at smartapi.angelone.in,
#                      "Create an app" -> type "Historical APIs" or "Trading APIs")
# ANGEL_CLIENT_CODE  : your Angel One client ID (e.g. A123456)
# ANGEL_MPIN         : the MPIN you log in to the Angel One app with
# ANGEL_TOTP_SECRET  : the base32 secret shown as a QR/text when you enable TOTP
#                      at smartapi.angelone.in/enable-totp (not the 6-digit code)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=
